# --- Glorious mice (wheelguard/hw/models.py GLORIOUS_LINKS): read-only until confirmed. Model O3 / D3
# (vendor 3794) and the Sinowealth wireless mice (vendor 258a). Never the bootloaders, never 258a:2014 or
# 3794:a100 (the app gives each to two products), no Bluetooth. Event nodes only when udev sees a pure mouse.
# Of the hidraw nodes only the settings interface, and only when the helper sees that it carries nothing
# but vendor collections (never the pointer, keys bound to buttons or media keys).
# Glorious Model O3 Wireless: wired (a312), dongle (a300, shared with the D3 Wireless)
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="3794", ATTRS{idProduct}=="a312", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="3794", ATTRS{idProduct}=="a300", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
# Glorious Model D3 Wireless: wired (a322), and the dongle above
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="3794", ATTRS{idProduct}=="a322", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
# Glorious Model O3: wired (a310)
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="3794", ATTRS{idProduct}=="a310", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
# Glorious Model D3: wired (a320)
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="3794", ATTRS{idProduct}=="a320", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
# Glorious Model O Wireless: wired (2011), dongle (2022)
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="2011", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="2022", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
# Glorious Model O- Wireless: wired (2013), dongle (2024)
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="2013", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
