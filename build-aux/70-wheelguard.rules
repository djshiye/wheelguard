# --- Glorious GMMK Pro keyboards (ANSI 5044, ISO 5046, later boards 5092 / 5093) and GMMK 2 keyboards
# (65% ANSI 5045, ISO 504a; 96% ANSI 504b, ISO 505a), stock firmware; GMMK 3 and GMMK 3 Pro wired keyboards
# (vendor 342d: 100% e3c8 / e3d1 and Pro e3c5 / e3ce, 75% e3c9 / e3d2 and Pro e3c6 / e3cf, 65% e3ca / e3d3 and
# Pro e3c7 / e3d0, ANSI / ISO), the GMMK 3 Pro Wireless by its USB cable (100% e3cb / e3d4, 75% e3cc / e3d5,
# 65% e3cd / e3d6; never its 2.4 GHz receiver or Bluetooth), the GMMK 3 HE and GMMK 3 Pro HE over USB (342d:e3d7-e3df and
# e3ec-e3f4, and their later USB IDs under vendor 3794: b300-b33b; never a receiver or Bluetooth) and the GMMK Numpad
# (320f:5088, USB only), the GMBK 75% (3794:b000, b001) and the GMMK Eternal 96 (3794:b010, b011; its
# settings collection is on usage page 0xFF60, which the helper accepts only when called with --eternal).
# Only the two vendor interfaces (settings and events) are granted, and only when the helper sees that the
# interface carries nothing that reports keys: Wheelguard can never read what is typed. Never the
# bootloaders (320f:B007-B00C, B00F, B010; 3794:B002, B003, B012; the GMMK 3's are under another vendor), and no input nodes.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="320f", ATTRS{idProduct}=="5044|5046|5092|5093|5045|504a|504b|505a|5088", IMPORT{program}="wheelguard-gmmk-check %S%p"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="342d", ATTRS{idProduct}=="e3c5|e3c6|e3c7|e3c8|e3c9|e3ca|e3cb|e3cc|e3cd|e3ce|e3cf|e3d0|e3d1|e3d2|e3d3|e3d4|e3d5|e3d6|e3d7|e3d8|e3d9|e3da|e3db|e3dc|e3dd|e3de|e3df|e3ec|e3ed|e3ee|e3ef|e3f0|e3f1|e3f2|e3f3|e3f4", IMPORT{program}="wheelguard-gmmk-check %S%p"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3794", ATTRS{idProduct}=="b300|b301|b302|b303|b304|b305|b306|b307|b308|b310|b311|b312|b313|b315|b317|b319|b31a|b31b|b320|b321|b322|b323|b324|b325|b326|b327|b328|b330|b331|b332|b333|b335|b337|b339|b33a|b33b|b000|b001", IMPORT{program}="wheelguard-gmmk-check %S%p"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3794", ATTRS{idProduct}=="b010|b011", IMPORT{program}="wheelguard-gmmk-check %S%p --eternal"
SUBSYSTEM=="hidraw", ENV{WHEELGUARD_GMMK}=="1", TAG+="uaccess"
