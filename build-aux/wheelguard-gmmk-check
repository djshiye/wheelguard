#!/usr/bin/python3 -IsP
"""udev helper: is this GMMK Pro / GMMK 2 / GMMK 3 hidraw node one of its two vendor interfaces (settings or events)?

Called by 70-wheelguard.rules as `wheelguard-gmmk-check %S%p` for the keyboard's hidraw nodes. Reads
the node's HID report descriptor from sysfs and prints WHEELGUARD_GMMK=1 only when the interface holds
the vendor settings collection (usage page 0xFF01, usage 1; GMMK 3 HE 0xFFFF, usage 2) or event collection
(0xFF00 / 0xFF00; GMMK 3 HE 0xFFFF, usage 1), or with --eternal the GMMK Eternal's (0xFF60 / 0x61), and
every top-level collection on it is a vendor one: a node that also carries the keyboard, media keys or
anything else that reports input is never granted, so no user process can read what is typed. Reads
only; writes nothing.
"""
import os
import sys

SETTINGS = bytes.fromhex("0601ff0901")
EVENTS = bytes.fromhex("0600ff0a00ff")
HE_SETTINGS = bytes.fromhex("06ffff0902")    # GMMK 3 HE: usage page 0xFFFF, usage 2
HE_EVENTS = bytes.fromhex("06ffff0901")      # and usage 1
ETERNAL = bytes.fromhex("0660ff0961")        # GMMK Eternal: usage page 0xFF60, usage 0x61 (only with --eternal)


def application_pages(desc: bytes):
    """Usage page of every top-level (application) collection in a HID report descriptor."""
    pages, page, depth, i = [], 0, 0, 0
    stack = []
    while i < len(desc):
        prefix = desc[i]
        if prefix == 0xFE:                          # long item
            if i + 1 >= len(desc):
                break
            i += 3 + desc[i + 1]
            continue
        n = (0, 1, 2, 4)[prefix & 3]
        val = int.from_bytes(desc[i + 1:i + 1 + n], "little")
        tag = prefix & 0xFC
        if tag == 0x04:                             # Usage Page
            page = val
        elif tag == 0xA4:                           # Push
            stack.append(page)
        elif tag == 0xB4 and stack:                 # Pop
            page = stack.pop()
        elif tag == 0xA0:                           # Collection
            if depth == 0:
                pages.append(page)
            depth += 1
        elif tag == 0xC0:                           # End Collection
            depth = max(0, depth - 1)
        i += 1 + n
    return pages


def vendor_only(desc: bytes, eternal: bool = False) -> bool:
    """The settings or event collection is here, and every collection on this node is a vendor one.
    `eternal`: the GMMK Eternal's settings page (the same page QMK uses, so only for the Eternal's own IDs)."""
    wanted = (ETERNAL,) if eternal else (SETTINGS, EVENTS, HE_SETTINGS, HE_EVENTS)
    if not any(c in desc for c in wanted):
        return False
    pages = application_pages(desc)
    return bool(pages) and all(p >= 0xFF00 for p in pages)


def main(argv) -> int:
    eternal = argv[2:] == ["--eternal"]
    if len(argv) != 2 and not eternal:
        return 1
    try:
        with open(os.path.join(argv[1], "device", "report_descriptor"), "rb") as f:
            desc = f.read(4096)
    except OSError:
        return 0
    if vendor_only(desc, eternal):
        print("WHEELGUARD_GMMK=1")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
