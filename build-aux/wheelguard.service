[Unit]
Description=wheelguard daemon (drops bouncing scroll-wheel ticks)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/libexec/wheelguard-daemon
Restart=on-failure
RestartSec=2

# Sandbox: the daemon only needs to read the mouse (/dev/input, /sys), create its virtual mouse
# (/dev/uinput), answer on its socket in $XDG_RUNTIME_DIR and keep ~/.config/wheelguard. Everything
# else is read-only or hidden, it has no network, and it can't gain privileges. Devices stay
# reachable as before: access to them is granted by the udev rule, not by this unit.
# ~/.config/wheelguard (created if missing, writable):
ConfigurationDirectory=wheelguard
ExecStartPre=+/usr/bin/mkdir -p %h/.local/share/wheelguard
ReadWritePaths=%t %h/.local/share/wheelguard
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=graphical-session.target
